+    // Parche local 07: horas silenciosas (idea de iNiR, services/Notifications.qml).
+    // Dentro de la ventana diaria los popups y el sonido se comportan como con
+    // No molestar, sin tocar SessionData.doNotDisturb: el DND manual sigue siendo
+    // del usuario. Críticas y reglas bypassDnd pasan igual que con DND. Si el
+    // fin es anterior al inicio, la ventana cruza la medianoche. Una hora mal
+    // escrita desactiva la ventana en vez de adivinar.
+    readonly property bool quietHoursEnabled: true
+    readonly property string quietHoursStart: "22:00"
+    readonly property string quietHoursEnd: "08:00"
+    property int _quietNowMin: _minutesOfDay(new Date())
+
+    function _minutesOfDay(d) {
+        return d.getHours() * 60 + d.getMinutes();
+    }
+
+    function _parseHourMinute(s) {
+        const m = /^(\d{1,2}):(\d{2})$/.exec(String(s).trim());
+        if (!m)
+            return -1;
+        const h = parseInt(m[1], 10), min = parseInt(m[2], 10);
+        return h > 23 || min > 59 ? -1 : h * 60 + min;
+    }
+
+    readonly property bool quietHoursActive: {
+        if (!quietHoursEnabled)
+            return false;
+        const start = _parseHourMinute(quietHoursStart);
+        const end = _parseHourMinute(quietHoursEnd);
+        if (start < 0 || end < 0 || start === end)
+            return false;
+        const now = _quietNowMin;
+        return start < end ? (now >= start && now < end) : (now >= start || now < end);
+    }
+
+    readonly property bool dndActive: SessionData.doNotDisturb || quietHoursActive
+
+    Timer {
+        interval: 30000
+        repeat: true
+        running: root.quietHoursEnabled
+        onTriggered: root._quietNowMin = root._minutesOfDay(new Date())
+    }
+
+    onQuietHoursActiveChanged: _applyDndToPopups()
+
+    function _applyDndToPopups() {
+        if (dndActive) {
+            notificationQueue = notificationQueue.filter(w => w && _allowedInDnd(w.urgency, w.bypassDnd));
+            for (const notif of visibleNotifications) {
+                if (!_allowedInDnd(notif.urgency, notif.bypassDnd))
+                    notif.popup = false;
+            }
+        }
+        processQueue();
+    }
