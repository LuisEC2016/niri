+    // Parche local 08: búsqueda en el historial (idea de iNiR, docs/NOTIFICATIONS.md).
+    // Aparece con más de tres entradas; busca en app, título y cuerpo, sin
+    // distinguir mayúsculas ni acentos, y se combina con el filtro de tiempo.
+    property string searchQuery: ""
+    readonly property bool searchAvailable: NotificationService.historyList.length > 3
+    readonly property string _normalizedQuery: searchAvailable ? _fold(searchQuery.trim()) : ""
+
+    function _fold(str) {
+        return String(str || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
+    }
+
+    function matchesQuery(n) {
+        if (!_normalizedQuery)
+            return true;
+        const hay = _fold((n.appName || "") + "\n" + (n.summary || "") + "\n" + (n.body || "").replace(/<[^>]*>/g, ""));
+        return _normalizedQuery.split(/\s+/).every(term => hay.includes(term));
+    }
