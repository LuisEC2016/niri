--- /dev/null
+++ b/Modules/OSD/OsdMacLevel.qml
@@ -0,0 +1,197 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import qs.Common
+import qs.Widgets
+
+// macOS Control Center style level: bold title over a thick capsule whose
+// white fill carries the icon. Drop-in for OsdLevelRow in the OSD popups.
+Item {
+    id: root
+
+    property string title: ""
+    property string iconName: "volume_up"
+    property color iconColor: root.onFillColor
+    property bool iconInteractive: false
+    property int value: 0
+    property int minimum: 0
+    property int maximum: 100
+    property string unit: "%"
+    property string displayText: ""
+    property bool muted: false
+    property bool sliderEnabled: true
+    property int wheelStep: 5
+
+    readonly property bool isLight: SessionData.isLightMode
+    readonly property color onFillColor: Qt.rgba(0.11, 0.11, 0.12, 0.72)
+    readonly property color fillColor: isLight ? "#ffffff" : Qt.rgba(1, 1, 1, 0.94)
+    readonly property color trackColor: isLight ? Qt.rgba(0, 0, 0, 0.10) : Qt.rgba(1, 1, 1, 0.14)
+    readonly property real padding: 12
+    readonly property real capsuleHeight: 18
+
+    readonly property bool containsMouse: capsuleArea.containsMouse || iconArea.containsMouse
+    readonly property bool isDragging: capsuleArea.pressed
+    readonly property real ratio: {
+        const span = Math.max(1, root.maximum - root.minimum);
+        return Math.max(0, Math.min(1, (root.value - root.minimum) / span));
+    }
+
+    signal sliderValueChanged(int newValue)
+    signal iconClicked
+    signal hoverChanged(bool hovered)
+
+    onContainsMouseChanged: root.hoverChanged(root.containsMouse)
+
+    function valueAt(x) {
+        const travel = Math.max(1, capsule.width - capsule.height);
+        const r = Math.max(0, Math.min(1, (x - capsule.height / 2) / travel));
+        return Math.round(root.minimum + r * (root.maximum - root.minimum));
+    }
+
+    function emitValue(v) {
+        const clamped = Math.max(root.minimum, Math.min(root.maximum, v));
+        if (clamped !== root.value)
+            root.sliderValueChanged(clamped);
+    }
+
+    StyledText {
+        id: titleLabel
+
+        anchors {
+            left: parent.left
+            leftMargin: root.padding + 1
+            right: statusLabel.left
+            rightMargin: Theme.spacingS
+            top: parent.top
+            topMargin: root.padding - 2
+        }
+        text: root.title
+        elide: Text.ElideRight
+        color: Theme.withAlpha(Theme.surfaceText, 0.92)
+        font.pixelSize: 12
+        font.weight: Font.DemiBold
+        font.letterSpacing: 0.1
+    }
+
+    StyledText {
+        id: statusLabel
+
+        anchors {
+            right: parent.right
+            rightMargin: root.padding + 1
+            baseline: titleLabel.baseline
+        }
+        text: root.displayText.length > 0 ? root.displayText : (SettingsData.osdAlwaysShowValue ? Math.round(root.value) + root.unit : "")
+        color: Theme.withAlpha(Theme.surfaceText, 0.5)
+        font.pixelSize: 11
+        font.weight: Font.Medium
+        font.features: {
+            "tnum": 1
+        }
+    }
+
+    Rectangle {
+        id: capsule
+
+        anchors {
+            left: parent.left
+            leftMargin: root.padding
+            right: parent.right
+            rightMargin: root.padding
+            bottom: parent.bottom
+            bottomMargin: root.padding
+        }
+        height: root.capsuleHeight
+        radius: height / 2
+        color: root.trackColor
+        border.width: root.isLight ? 1 : 0
+        border.color: Qt.rgba(0, 0, 0, 0.06)
+        opacity: root.sliderEnabled ? 1 : 0.5
+
+        Rectangle {
+            id: fill
+
+            anchors {
+                left: parent.left
+                top: parent.top
+                bottom: parent.bottom
+            }
+            width: capsule.height + (capsule.width - capsule.height) * root.ratio
+            radius: height / 2
+            color: root.fillColor
+            opacity: root.muted ? 0.45 : 1
+
+            Behavior on width {
+                enabled: !root.isDragging
+                NumberAnimation {
+                    duration: 140
+                    easing.type: Easing.OutCubic
+                }
+            }
+
+            Behavior on opacity {
+                NumberAnimation {
+                    duration: 160
+                }
+            }
+        }
+
+        MouseArea {
+            id: capsuleArea
+
+            anchors.fill: parent
+            enabled: root.sliderEnabled
+            hoverEnabled: true
+            preventStealing: true
+            cursorShape: Qt.PointingHandCursor
+            onPressed: mouse => root.emitValue(root.valueAt(mouse.x))
+            onPositionChanged: mouse => {
+                if (pressed)
+                    root.emitValue(root.valueAt(mouse.x));
+            }
+            onWheel: wheel => {
+                const delta = wheel.angleDelta.y !== 0 ? wheel.angleDelta.y : -wheel.angleDelta.x;
+                if (delta === 0)
+                    return;
+                root.emitValue(root.value + (delta > 0 ? root.wheelStep : -root.wheelStep));
+            }
+        }
+
+        Item {
+            id: iconSlot
+
+            anchors {
+                left: parent.left
+                top: parent.top
+                bottom: parent.bottom
+            }
+            width: capsule.height
+
+            DankIcon {
+                anchors.centerIn: parent
+                name: root.iconName
+                size: 12
+                filled: true
+                color: root.iconColor
+                scale: iconArea.containsMouse && root.iconInteractive ? 1.12 : 1
+
+                Behavior on scale {
+                    NumberAnimation {
+                        duration: 120
+                        easing.type: Easing.OutCubic
+                    }
+                }
+            }
+
+            MouseArea {
+                id: iconArea
+
+                anchors.fill: parent
+                enabled: root.iconInteractive
+                hoverEnabled: true
+                cursorShape: Qt.PointingHandCursor
+                onClicked: root.iconClicked()
+            }
+        }
+    }
+}
